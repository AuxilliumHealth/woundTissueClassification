<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"

    android:orientation="vertical">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_risk_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Risk Score Required"
        android:textColor="#000000"
        app:thumbTint="@color/colorPrimary"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:checked="true" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_body_selection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Body Selection Required"
        android:textColor="#000000"
        app:thumbTint="@color/colorPrimary"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:checked="true" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_calibration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calibration Required"
        android:textColor="#000000"
        app:thumbTint="@color/colorPrimary"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:checked="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/wound_layout_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wound Tissue Classification"
     android:layout_gravity="center_horizontal"
        android:textColor="@color/white"
        android:backgroundTint="@color/colorPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/wound_list_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/white"
        android:text="Preview Wound List"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="@color/colorPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</LinearLayout>
</RelativeLayout>