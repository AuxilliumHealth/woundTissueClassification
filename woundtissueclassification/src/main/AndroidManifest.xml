<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />


    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />


    <uses-feature android:name="android.hardware.camera.any" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".Activities.LatestWoundListActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.WoundDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.WoundListActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.ResultsActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.SymptomQuestionActivity"
            android:exported="false"
            android:windowOptOutEdgeToEdgeEnforcement="true" />
        <activity
            android:name=".Activities.LassoActivity"
            android:exported="false"
            android:windowOptOutEdgeToEdgeEnforcement="true" />
        <activity
            android:name=".Activities.ImagePreviewActivity"
            android:exported="false"
            android:windowOptOutEdgeToEdgeEnforcement="true" />
        <activity
            android:name=".Activities.WoundLocationActivity"
            android:exported="false"
            android:windowOptOutEdgeToEdgeEnforcement="true" />
        <activity
            android:name=".Activities.CalibrationActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowOptOutEdgeToEdgeEnforcement="true"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".Activities.CameraActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:windowOptOutEdgeToEdgeEnforcement="true"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity
            android:name=".Activities.VideoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:windowOptOutEdgeToEdgeEnforcement="true"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity
            android:name=".Activities.WoundImageEditActivity"
            android:exported="false" />
    </application>

</manifest>